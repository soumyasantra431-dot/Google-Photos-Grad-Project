{
  "name": "google-photos-grad-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "deploy": "pnpm run build && wrangler deploy --config dist/google_photos_grad_project/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply photo-recall-evidence --local",
    "db:migrate:remote": "wrangler d1 migrations apply photo-recall-evidence --remote",
    "collect:app-store": "node scripts/collect-app-store.mjs",
    "collect:google-support": "node scripts/collect-google-support.mjs",
    "ingest:curated": "node scripts/ingest-curated-public.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.133.0"
  }
}
